generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  HR_MANAGER
  HR_SUPERVISOR
  HR_USER
  BRANCH_MANAGER
  EMPLOYEE
  DEVICE_MANAGER
}

enum HiringAppointmentStatus {
  pending
  approved
  rejected
  cancelled
}

enum PayrollState {
  draft
  calculated
  confirmed
}

enum DeductionState {
  draft
  linked
  cancelled
}

enum AdvanceState {
  pending
  applied
  draft
  running
  done
  cancelled
  /// HR stopped further payroll deductions; paid instalments stay.
  stopped
  confirmed
  paid
}

enum ShiftGridState {
  setup
  grid
  confirmed
}

enum SyncJobStatus {
  pending
  running
  done
  failed
  cancelled
}

enum RequestState {
  draft
  pending
  approved
  rejected
  cancelled
}

/// Two-step approval for employee-submitted advances. Separate from `RequestState`
/// because that enum is shared by six unrelated request models.
enum AdvanceRequestState {
  pending_branch
  pending_hr
  approved
  rejected
  cancelled
}

model Company {
  id        String   @id @default(cuid())
  /// Login identifier employees type on the sign-in screen (case-insensitive unique).
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                      User[]
  userFeatureGrants          UserFeatureGrant[]
  auditLogs                  AuditLog[]
  dashboardNotificationReads DashboardNotificationRead[]
  apiTokens                  ApiToken[]
  employees                  EmployeeProfile[]
  custodyTypes               CustodyType[]
  employeeCustodies          EmployeeCustody[]
  locations                  Location[]
  insuranceCompanies         InsuranceCompany[]
  jobTitles                  JobTitle[]
  jobLevels                  JobLevel[]
  archiveReasons             ArchiveReason[]
  biotimeConfigs             BioTimeConfig[]
  departments                Department[]
  departmentMappings         DepartmentMapping[]
  employeeMappings           EmployeeMapping[]
  devices                    Device[]
  transactions               Transaction[]
  attendances                Attendance[]
  shifts                     Shift[]
  shiftAssignments           ShiftAssignment[]
  shiftGrids                 ShiftGrid[]
  shiftGridLines             ShiftGridLine[]
  shiftGridManualOtLines     ShiftGridManualOtLine[]
  odooConfigs                OdooConfig[]
  odooSyncMaps               OdooSyncMap[]
  syncJobs                   SyncJob[]
  payrolls                   Payroll[]
  payrollLines               PayrollLine[]
  deductions                 Deduction[]
  systemCounters             SystemCounter[]
  punchReportImports         PunchReportImport[]
  advanceLoanImports         AdvanceLoanImport[]
  advanceLoanImportLines     AdvanceLoanImportLine[]
  advancesShort              AdvanceShort[]
  advancesLong               AdvanceLong[]
  advanceLongPayments        AdvanceLongPayment[]
  leaveRequests              LeaveRequest[]
  loanRequests               LoanRequest[]
  advanceRequests            AdvanceRequest[]
  shiftChangeRequests        ShiftChangeRequest[]
  salaryRequests             SalaryRequest[]
  certificateRequests        CertificateRequest[]
  attendanceEditRequests     AttendanceEditRequest[]
  overtimeAnalyses           OvertimeAnalysis[]
  hiringAppointments         HiringAppointment[]

  @@map("companies")
}

model User {
  companyId            String?   @map("company_id")
  id                   String    @id @default(cuid())
  login                String
  email                String?
  name                 String
  passwordHash         String    @map("password_hash")
  initialPassword      String?   @map("initial_password")
  /// SHA-256 hex of one-time reset token (raw token only in email link).
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  role                 UserRole  @default(EMPLOYEE)
  locationId           String?   @map("location_id")
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  location                  Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employeeProfile           EmployeeProfile?
  apiTokens                 ApiToken[]
  hiringAppointmentsCreated HiringAppointment[] @relation("HiringAppointmentCreator")
  featureGrants             UserFeatureGrant[]  @relation("FeatureGrantUser")
  featureGrantsGiven        UserFeatureGrant[]  @relation("FeatureGrantBy")
  company                   Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, login])
  @@index([locationId])
  @@index([companyId])
  @@map("users")
}

model UserFeatureGrant {
  companyId   String?  @map("company_id")
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  feature     String
  enabled     Boolean  @default(true)
  grantedById String?  @map("granted_by_id")
  grantedAt   DateTime @default(now()) @map("granted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User     @relation("FeatureGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?    @relation("FeatureGrantBy", fields: [grantedById], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([userId, feature])
  @@index([feature, enabled])
  @@index([companyId])
  @@map("user_feature_grants")
}

model AuditLog {
  companyId   String?   @map("company_id")
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  actorId     String?   @map("actor_id")
  actorLogin  String    @map("actor_login")
  actorName   String?   @map("actor_name")
  actorRole   UserRole? @map("actor_role")
  module      String
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  summary     String
  counts      Json?
  diffPreview Json?     @map("diff_preview")
  payload     Json?
  route       String?
  ip          String?
  requestId   String?   @map("request_id")
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model DashboardNotificationRead {
  companyId      String?  @map("company_id")
  id             String   @id @default(cuid())
  readerKey      String   @map("reader_key")
  notificationId String   @map("notification_id")
  readAt         DateTime @default(now()) @map("read_at")
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([readerKey, notificationId])
  @@index([readerKey])
  @@index([companyId])
  @@map("dashboard_notification_reads")
}

model ApiToken {
  companyId  String?  @map("company_id")
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String   @map("user_id")
  deviceInfo String?  @map("device_info")
  expiryDate DateTime @map("expiry_date")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([companyId])
  @@map("api_tokens")
}

model EmployeeProfile {
  companyId                   String    @map("company_id")
  id                          String    @id @default(cuid())
  userId                      String?   @unique @map("user_id")
  name                        String
  displayName                 String?   @map("display_name")
  code                        String?
  identificationId            String?   @map("identification_id")
  barcode                     String?
  departmentId                String?   @map("department_id")
  jobTitle                    String?   @map("job_title")
  workPhone                   String?   @map("work_phone")
  mobilePhone                 String?   @map("mobile_phone")
  workEmail                   String?   @map("work_email")
  /// Plaintext HR-visible password paired with workEmail (copy/export). Not a login hash.
  workEmailPassword           String?   @map("work_email_password")
  gender                      String?
  location                    String?
  address                     String?
  locationId                  String?   @map("location_id")
  /// Direct manager in the org chart (self-relation).
  managerId                   String?   @map("manager_id")
  basicSalary                 Float     @default(0) @map("basic_salary")
  hiringDate                  DateTime? @map("hiring_date")
  departureDate               DateTime? @map("departure_date")
  nationalIdConfirm           String?   @map("national_id_confirm")
  /// Non-Egyptian employee: national ID is optional / not Egyptian-format validated.
  isForeigner                 Boolean   @default(false) @map("is_foreigner")
  birthday                    DateTime? @map("birthday")
  // Documents
  qualificationOriginal       Boolean   @default(false) @map("qualification_original")
  qualificationDocStatus      String    @default("none") @map("qualification_doc_status")
  criminalRecord              Boolean   @default(false) @map("criminal_record")
  birthCertificateOriginal    Boolean   @default(false) @map("birth_certificate_original")
  birthCertificateDocStatus   String    @default("none") @map("birth_certificate_doc_status")
  workStub                    Boolean   @default(false) @map("work_stub")
  militaryServiceDoc          Boolean   @default(false) @map("military_service_doc")
  militaryDocStatus           String    @default("none") @map("military_doc_status")
  idCardPhoto                 Boolean   @default(false) @map("id_card_photo")
  idCardPhotoUrl              String?   @map("id_card_photo_url")
  personalPhoto               Boolean   @default(false) @map("personal_photo")
  personalPhotoCount          Int       @default(0) @map("personal_photo_count")
  personalPhotoDocUrl         String?   @map("personal_photo_doc_url")
  insurancePrint              Boolean   @default(false) @map("insurance_print")
  insurancePrintUrl           String?   @map("insurance_print_url")
  qualificationDocUrl         String?   @map("qualification_doc_url")
  militaryDocUrl              String?   @map("military_doc_url")
  birthCertificateDocUrl      String?   @map("birth_certificate_doc_url")
  criminalRecordDocUrl        String?   @map("criminal_record_doc_url")
  // Skills & health
  skillLevel                  String?   @map("skill_level")
  hasSkillLevel               Boolean   @default(false) @map("has_skill_level")
  healthCertificate           Boolean   @default(false) @map("health_certificate")
  healthCertificateIssueDate  DateTime? @map("health_certificate_issue_date")
  healthCertificateExpiryDate DateTime? @map("health_certificate_expiry_date")
  // Insurance
  insuranceNumber             String?   @map("insurance_number")
  insuranceStatus             String?   @map("insurance_status")
  insuranceCompanyId          String?   @map("insurance_company_id")
  insuranceSalary             Float     @default(0) @map("insurance_salary")
  medicalInsuranceStatus      String?   @map("medical_insurance_status")
  medicalInsuranceCompanyId   String?   @map("medical_insurance_company_id")
  medicalInsuranceSalary      Float     @default(0) @map("medical_insurance_salary")
  // Accounts & leave
  mobileLine                  Boolean   @default(false) @map("mobile_line")
  hasFawryAccount             Boolean   @default(false) @map("has_fawry_account")
  fawryAccount                String?   @map("fawry_account")
  misrAccount                 Boolean   @default(false) @map("misr_account")
  bankIban                    String?   @map("bank_iban")
  mobileLinePhone             String?   @map("mobile_line_phone")
  laptopProvided              Boolean   @default(false) @map("laptop_provided")
  mobileProvided              Boolean   @default(false) @map("mobile_provided")
  leaveStartingBalance        Float     @default(0) @map("leave_starting_balance")
  usedLeaveDays               Float     @default(0) @map("used_leave_days")
  remainingLeaveBalance       Float     @default(0) @map("remaining_leave_balance")
  active                      Boolean   @default(true)
  archivedAt                  DateTime? @map("archived_at")
  archiveReason               String?   @map("archive_reason")
  biotimeSynced               Boolean   @default(false) @map("biotime_synced")
  biotimeDeviceId             String?   @map("biotime_device_id")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  user                    User?                   @relation(fields: [userId], references: [id])
  department              Department?             @relation(fields: [departmentId], references: [id])
  workLocation            Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  manager                 EmployeeProfile?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports           EmployeeProfile[]       @relation("EmployeeManager")
  insuranceCompany        InsuranceCompany?       @relation("EmployeeInsuranceCompany", fields: [insuranceCompanyId], references: [id], onDelete: SetNull)
  medicalInsuranceCompany InsuranceCompany?       @relation("EmployeeMedicalInsuranceCompany", fields: [medicalInsuranceCompanyId], references: [id], onDelete: SetNull)
  mapping                 EmployeeMapping?
  attendances             Attendance[]
  shiftAssignments        ShiftAssignment[]
  shiftGridLines          ShiftGridLine[]
  payrollLines            PayrollLine[]
  deductions              Deduction[]
  advancesShort           AdvanceShort[]
  advancesLong            AdvanceLong[]
  advanceLoanImportLines  AdvanceLoanImportLine[]
  transactions            Transaction[]
  leaveRequests           LeaveRequest[]
  loanRequests            LoanRequest[]
  advanceRequests         AdvanceRequest[]
  managedLocations        Location[]              @relation("LocationManager")
  shiftChangeRequests     ShiftChangeRequest[]
  salaryRequests          SalaryRequest[]
  certificateRequests     CertificateRequest[]
  attendanceEditRequests  AttendanceEditRequest[]
  overtimeAnalyses        OvertimeAnalysis[]
  hiringAppointment       HiringAppointment?
  custodies               EmployeeCustody[]
  shiftGridManualOtLines  ShiftGridManualOtLine[]
  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, code])
  @@index([companyId, active, locationId])
  @@index([code])
  @@index([active, locationId])
  @@index([archivedAt])
  @@index([managerId])
  @@map("employee_profiles")
}

model CustodyType {
  companyId String   @map("company_id")
  id        String   @id @default(cuid())
  name      String
  code      String?
  active    Boolean  @default(true)
  sequence  Int      @default(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments EmployeeCustody[]
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("custody_types")
}

model EmployeeCustody {
  companyId     String   @map("company_id")
  id            String   @id @default(cuid())
  employeeId    String   @map("employee_id")
  custodyTypeId String   @map("custody_type_id")
  provided      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  custodyType CustodyType     @relation(fields: [custodyTypeId], references: [id], onDelete: Cascade)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, custodyTypeId])
  @@index([custodyTypeId])
  @@index([companyId])
  @@map("employee_custodies")
}

model Location {
  companyId              String   @map("company_id")
  id                     String   @id @default(cuid())
  name                   String
  code                   String?
  active                 Boolean  @default(true)
  sequence               Int      @default(10)
  actualName             String?  @map("actual_name")
  loanNotificationEmails String[] @default([]) @map("loan_notification_emails")
  /// Who signs off advance requests for this branch. Null falls back to the most
  /// senior person the org chart derives for the site.
  managerEmployeeId      String?  @map("manager_employee_id")
  /// When true, employees at this branch can punch via mobile GPS (same transactions table).
  locationPunchEnabled   Boolean  @default(false) @map("location_punch_enabled")
  latitude               Float?
  longitude              Float?
  geofenceRadiusMeters   Int      @default(200) @map("geofence_radius_meters")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  manager            EmployeeProfile?    @relation("LocationManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees          EmployeeProfile[]
  shiftGrids         ShiftGrid[]
  users              User[]
  devices            Device[]
  hiringAppointments HiringAppointment[]
  advanceRequests    AdvanceRequest[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([managerEmployeeId])
  @@index([companyId])
  @@map("locations")
}

model InsuranceCompany {
  companyId String   @map("company_id")
  id        String   @id @default(cuid())
  name      String
  code      String?
  active    Boolean  @default(true)
  sequence  Int      @default(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees        EmployeeProfile[] @relation("EmployeeInsuranceCompany")
  medicalEmployees EmployeeProfile[] @relation("EmployeeMedicalInsuranceCompany")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId])
  @@map("insurance_companies")
}

model JobTitle {
  companyId String   @map("company_id")
  id        String   @id @default(cuid())
  name      String
  code      String?
  active    Boolean  @default(true)
  sequence  Int      @default(10)
  /// Seniority tier this title sits in. Null = fall back to the built-in heuristic.
  levelId   String?  @map("level_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  level   JobLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  company Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([levelId])
  @@index([companyId])
  @@map("job_titles")
}

/// Configurable seniority tiers for the org chart («تدرج الوظائف»).
/// `rank` orders the ladder — 1 is the most senior. Several titles share a tier.
model JobLevel {
  companyId String   @map("company_id")
  id        String   @id @default(cuid())
  name      String
  nameEn    String?  @map("name_en")
  code      String?
  rank      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  titles  JobTitle[]
  company Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@unique([companyId, rank])
  @@unique([companyId, code])
  @@index([companyId])
  @@map("job_levels")
}

/// Selectable reasons when archiving an employee (إنهاء / استقالة / …).
model ArchiveReason {
  companyId String   @map("company_id")
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sequence  Int      @default(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("archive_reasons")
}

model BioTimeConfig {
  companyId                    String    @map("company_id")
  id                           String    @id @default(cuid())
  serverIp                     String    @default("") @map("server_ip")
  serverPort                   Int       @default(8090) @map("server_port")
  useHttps                     Boolean   @default(false) @map("use_https")
  username                     String    @default("")
  password                     String    @default("")
  authType                     String    @default("jwt") @map("auth_type")
  authToken                    String?   @map("auth_token")
  tokenExpiry                  DateTime? @map("token_expiry")
  isConnected                  Boolean   @default(false) @map("is_connected")
  timezone                     String    @default("Africa/Cairo")
  scheduledAutoSyncEnabled     Boolean   @default(true) @map("scheduled_auto_sync_enabled")
  autoSyncEmployees            Boolean   @default(true) @map("auto_sync_employees")
  autoSyncDepartments          Boolean   @default(true) @map("auto_sync_departments")
  autoSyncTransactions         Boolean   @default(true) @map("auto_sync_transactions")
  autoPushToBiotime            Boolean   @default(false) @map("auto_push_to_biotime")
  autoPushDeletes              Boolean   @default(false) @map("auto_push_deletes")
  defaultBiotimeAreaId         Int?      @map("default_biotime_area_id")
  employeeSyncIntervalHours    Int       @default(12) @map("employee_sync_interval_hours")
  transactionSyncIntervalMins  Int       @default(15) @map("transaction_sync_interval_mins")
  duplicateGraceMinutes        Int       @default(1) @map("duplicate_grace_minutes")
  duplicatePolicy              String    @default("mark") @map("duplicate_policy")
  lastEmployeeSync             DateTime? @map("last_employee_sync")
  lastDepartmentSync           DateTime? @map("last_department_sync")
  lastTransactionSync          DateTime? @map("last_transaction_sync")
  companyLogoPath              String?   @map("company_logo_path")
  advanceDefaultPercent        Float     @default(25) @map("advance_default_percent")
  advanceMinimumWorkingDays    Float     @default(15) @map("advance_minimum_working_days")
  advanceEnforceLimit          Boolean   @default(true) @map("advance_enforce_limit")
  advanceEligibilitySource     String    @default("punch_report") @map("advance_eligibility_source")
  // Late deduction ladder: up to grace = free, then quarter day, then half day, above = full day.
  lateGraceMinutes             Int       @default(20) @map("late_grace_minutes")
  lateQuarterDayMaxMinutes     Int       @default(30) @map("late_quarter_day_max_minutes")
  lateHalfDayMaxMinutes        Int       @default(60) @map("late_half_day_max_minutes")
  // Late days excused per period before the ladder applies. 0 disables the allowance.
  lateForgivenDaysCount        Int       @default(2) @map("late_forgiven_days_count")
  // Which late days the allowance consumes: "oldest" by date, or "largest" by minutes.
  lateForgivenDaysSelection    String    @default("oldest") @map("late_forgiven_days_selection")
  // Whose grace wins when a shift sets its own: "longest", "policy" or "shift".
  lateGracePrecedence          String    @default("longest") @map("late_grace_precedence")
  // Cap on bus-delay permissions reported per period; the cap is skipped when disabled.
  latePermissionCap            Int       @default(2) @map("late_permission_cap")
  latePermissionCapEnabled     Boolean   @default(true) @map("late_permission_cap_enabled")
  // Day of month the payroll period starts on, used to propose merge ranges.
  payrollMonthStartDay         Int       @default(26) @map("payroll_month_start_day")
  /// When true, payable base days use payrollFixedMonthDays (e.g. 30) instead of calendar length.
  payrollFixedMonthDaysEnabled Boolean   @default(false) @map("payroll_fixed_month_days_enabled")
  /// Payable month length when fixed mode is on (typically 30).
  payrollFixedMonthDays        Int       @default(30) @map("payroll_fixed_month_days")
  /// First N unpaid absences in a period do not count toward «غياب بدون إذن» penalty.
  absentForgivenDaysCount      Int       @default(4) @map("absent_forgiven_days_count")
  /// Job title ids allowed on tips import templates.
  tipJobTitleIds               String[]  @default([]) @map("tip_job_title_ids")
  // Weekday the weekly schedule starts on, 0 = Sunday through 6 = Saturday.
  gridWeekStartDay             Int       @default(0) @map("grid_week_start_day")
  // Who an employee may see on the schedule: none, department, branch or all.
  employeeTeamScheduleScope    String    @default("department") @map("employee_team_schedule_scope")
  // What of a colleague's day is revealed. Absence reasons are off by default.
  employeeTeamShowShiftTimes   Boolean   @default(true) @map("employee_team_show_shift_times")
  employeeTeamShowOffDays      Boolean   @default(true) @map("employee_team_show_off_days")
  employeeTeamShowLeave        Boolean   @default(false) @map("employee_team_show_leave")
  employeeTeamShowSickLeave    Boolean   @default(false) @map("employee_team_show_sick_leave")
  // Hours after overnight end still on that shift; each shift can override lateCheckoutThreshold.
  defaultLateCheckoutHours     Float     @default(4) @map("default_late_checkout_hours")
  // Hours before next shift start counted as early check-in (caps overnight leave window).
  defaultEarlyCheckinHours     Float     @default(2) @map("default_early_checkin_hours")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  company                      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId])
  @@index([companyId])
  @@map("biotime_config")
}

model Department {
  companyId       String   @map("company_id")
  id              String   @id @default(cuid())
  name            String
  nameEn          String?  @map("name_en")
  code            String?
  sequence        Int      @default(10)
  biotimeDeptId   Int?     @map("biotime_dept_id")
  biotimeDeptCode String?  @map("biotime_dept_code")
  active          Boolean  @default(true)
