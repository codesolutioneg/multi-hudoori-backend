/// An employee (or their branch manager) asking for a short advance.
/// Approval by HR is what actually creates the `AdvanceShort` that payroll deducts;
/// until then this row only reserves the amount against the employee's entitlement.
model AdvanceRequest {
  companyId     String              @map("company_id")
  id            String              @id @default(cuid())
  employeeId    String              @map("employee_id")
  /// User who submitted — the employee themselves, or a manager acting for them.
  requestedById String              @map("requested_by_id")
  /// Frozen at submit so the branch queue stays stable if the employee moves site.
  locationId    String?             @map("location_id")
  amount        Float
  reason        String
  state         AdvanceRequestState @default(pending_branch)

  /// Entitlement as it stood when the request was filed, for later review.
  eligibilityPercent         Float? @map("eligibility_percent")
  maxEligibleAtRequest       Float? @map("max_eligible_at_request")
  availableAtRequest         Float? @map("available_at_request")
  actualWorkingDaysAtRequest Float? @map("actual_working_days_at_request")

  branchApprovedById String?   @map("branch_approved_by_id")
  branchApprovedAt   DateTime? @map("branch_approved_at")
  hrApprovedById     String?   @map("hr_approved_by_id")
  hrApprovedAt       DateTime? @map("hr_approved_at")
  rejectedById       String?   @map("rejected_by_id")
  rejectionReason    String?   @map("rejection_reason")

  /// HR may approve above the entitlement, but only with a written reason.
  limitOverride  Boolean @default(false) @map("limit_override")
  overrideReason String? @map("override_reason")

  /// The advance created on approval. Null until HR approves.
  advanceShortId String? @unique @map("advance_short_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId, state])
  @@index([state, locationId])
  @@index([companyId])
  @@map("advance_requests")
}

