{
  "name": "hudoori-multi-backend",
  "version": "1.0.0",
  "description": "Hudoori Multi company API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:up": "docker compose -f ../docker-compose.dev.yml up -d",
    "setup": "prisma migrate deploy && npm run prisma:seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:db:up": "bash scripts/test-db.sh up",
    "test:db:down": "bash scripts/test-db.sh down",
    "test:db:reset": "bash scripts/test-db.sh reset",
    "typecheck": "tsc --noEmit",
    "load": "node tests/load/run.mjs",
    "load:k6": "k6 run tests/load/k6-api.js",
    "db:clean": "ts-node src/scripts/cleanTestData.ts",
    "db:reset": "ts-node src/scripts/resetDatabase.ts",
    "biotime:probe": "ts-node src/scripts/probeBioTime.ts",
    "odoo:pull": "ts-node src/scripts/pullFromOdoo.ts",
    "server:odoo-sync": "ts-node src/scripts/serverOdooSync.ts",
    "tunnel": "ngrok http 3000",
    "public": "ts-node scripts/startPublic.ts",
    "public:deploy": "ts-node scripts/startPublic.ts --push"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.6",
    "arabic-persian-reshaper": "^1.0.1",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "bidi-js": "^1.0.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "openapi-types": "^12.1.3",
    "pdfkit": "^0.19.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "puppeteer": "^24.43.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.17.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autocannon": "^8.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
